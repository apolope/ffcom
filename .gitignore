# Node / client
node_modules/
dist/
dist-electron/
release/
# pacote Go do índice assinado, não é saída de build (o padrão acima é do electron-builder)
!/server-channel/internal/release/
.vite/
# Cópia de locales/ para o build Docker do client (ver client/Dockerfile)
/client/locales/
*.local

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
/server-central/bin/
/server-channel/bin/
vendor/
# O site embute bibliotecas de navegador em site/assets/vendor (ver
# site/README.md), que não é o vendor do Go.
!site/assets/vendor/

# Env / secrets
.env
.env.*
!.env.example
# Configuração do Firebase do app Android (push, fase 6): específica da
# instância, vem do secret ANDROID_GOOGLE_SERVICES_JSON no CI e é copiada à
# mão no build local (ver client/README.md).
/client/android/app/google-services.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
