<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Liga o app ao site para o navigator.getInstalledRelatedApps do
             Chrome: o botão "Instalar o app" do client no navegador some
             quando este APK já está instalado. Ver docs/architecture.md,
             "Decisão: botão de instalar o app nativo pelo navegador". -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links verificados (assetlinks.json em
                 https://app.ffcom.a3sitsolutions.com.br/.well-known/): o
                 retorno do login no Custom Tab (/auth/android) e os convites
                 (/convite, fase 4). Com o singleTask acima, a URL chega à
                 Activity aberta por onNewIntent, que o @capacitor/app passa à
                 página como appUrlOpen. Ver docs/architecture.md, "Decisão:
                 login do app Android no navegador do sistema (fase 3)". -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.ffcom.a3sitsolutions.com.br" />
                <data android:path="/auth/android" />
                <data android:path="/convite" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Chamada em segundo plano (fase 5): serviço em primeiro plano
             enquanto há chamada, com a notificação "Em chamada". microphone
             mantém o microfone com a tela apagada; mediaPlayback segura quem
             entrou só ouvindo (ver CallNotice.foregroundTypes). stopWithTask:
             tirar o app dos recentes leva a WebView e a chamada, então o
             serviço vai junto. Ver docs/architecture.md, "Decisão: chamada em
             segundo plano no Android (fase 5)". -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:stopWithTask="true" />

        <!-- Notificações push (fase 6): as mensagens do FCM são só dados, e
             este serviço monta as notificações (agrupadas por canal). É o
             único com MESSAGING_EVENT no app; o @capacitor/push-notifications
             não é usado, porque o serviço dele disputaria o mesmo evento. Ver
             docs/architecture.md, "Decisão: notificações push no app Android
             (fase 6, client)". -->
        <service
            android:name=".PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microfone e câmera da chamada. O getUserMedia da WebView pede a
         permissão do Android na hora (BridgeWebChromeClient.onPermissionRequest
         do Capacitor); negar faz o getUserMedia falhar com NotAllowedError, que
         o client já traduz (voice.mic.permissionDenied e
         voice.camera.permissionDenied em hooks/useVoiceChannel.ts). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Abrir o instalador com o APK novo baixado pelo UpdatePlugin. Na
         primeira vez o Android pede "Permitir desta fonte"
         (canRequestPackageInstalls). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Serviço da chamada (CallService, fase 5): o serviço em primeiro plano
         e os dois tipos dele (Android 14+), a notificação "Em chamada"
         (Android 13+ pede à pessoa; negada, o serviço roda igual, sem a
         notificação visível) e o wake lock que segura a CPU com a tela
         apagada. POST_NOTIFICATIONS vale também para o push (fase 6); quem
         pede e quando fica em NotificationAccess. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A câmera é opcional: sem ela o app instala e funciona só com voz. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
