{
  "name": "ffcom-client",
  "private": true,
  "version": "0.0.0",
  "description": "Interface gráfica do FFCom (web/PWA e desktop Electron)",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Apolonio Serafim",
  "license": "AGPL-3.0-or-later",
  "desktopName": "FFCom.desktop",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "electron": "electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:pwa-assets": "pwa-assets-generator",
    "generate:electron-icon": "node generate-electron-icon.mjs",
    "package": "npm run build:electron && electron-builder --publish never",
    "package:win": "npm run build:electron && electron-builder --win --publish never",
    "package:mac": "npm run build:electron && electron-builder --mac --publish never",
    "package:linux": "npm run build:electron && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "livekit-client": "^2.22.3",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "tweetnacl": "^1.0.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.a3sitsolutions.ffcom",
    "productName": "FFCom",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "artifactName": "FFCom-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    },
    "protocols": [
      {
        "name": "FFCom",
        "schemes": [
          "ffcom"
        ]
      }
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/apolope/ffcom/releases/download/desktop-stable"
      }
    ]
  }
}
