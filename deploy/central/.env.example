# Copiar para /opt/ffcom/envs/ffcom-central.env no host (SVRUBS24IPS0101),
# fora do git — carregado pelo workflow deploy-ffcom-central.yml antes do
# `docker compose up`. IMAGE_TAG é setado pelo próprio workflow, não precisa
# entrar aqui.

POSTGRES_USER=ffcom
POSTGRES_PASSWORD=
POSTGRES_DB=ffcom_central

OIDC_ISSUER_URL=https://authentik.abs.a3sitsolutions.com.br/application/o/ffcom/

# Domínio do client publicado via NPM — sem barra final.
CORS_ALLOWED_ORIGINS=https://app.ffcom.a3sitsolutions.com.br

# Rate limiting por IP (opcionais; padrão 120 req/min, burst 20 se omitidas).
# RATE_LIMIT_RPM=120
# RATE_LIMIT_BURST=20

# Exige X-Forwarded-Proto: https em toda requisição (ver
# docs/architecture.md, "Criptografia em trânsito obrigatória"). Confirmar
# antes de ligar que o NPM em VMSUBS24OCI0102 seta esse header nos 4
# hostnames — se sim, ligar aqui e nas outras instâncias.
# REQUIRE_TLS=true
