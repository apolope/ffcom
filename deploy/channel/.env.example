# Copiar para /opt/ffcom/envs/ffcom-channel.env no host (SVRUBS24IPS0101),
# fora do git — carregado pelo workflow deploy-ffcom-channel.yml antes do
# `docker compose up`. IMAGE_TAG é setado pelo próprio workflow.

POSTGRES_USER=ffcom
POSTGRES_PASSWORD=
POSTGRES_DB=ffcom_channel

OIDC_ISSUER_URL=https://authentik.abs.a3sitsolutions.com.br/application/o/ffcom/
CORS_ALLOWED_ORIGINS=https://app.ffcom.a3sitsolutions.com.br

# Exige X-Forwarded-Proto: https em toda requisição (ver
# docs/architecture.md, "Criptografia em trânsito obrigatória"). Confirmar
# antes de ligar que o NPM em VMSUBS24OCI0102 seta esse header nos 4
# hostnames — se sim, ligar aqui e nas outras instâncias.
# REQUIRE_TLS=true

# Rate limiting (opcionais; padrões abaixo se omitidas). RPM/BURST por IP
# sobre a API REST; WS_RPM/WS_BURST por membro sobre frames de mensagem numa
# conexão já aberta — ver docs/architecture.md, "Decisão: rate limiting em
# server-channel".
# RATE_LIMIT_RPM=120
# RATE_LIMIT_BURST=20
# RATE_LIMIT_WS_RPM=60
# RATE_LIMIT_WS_BURST=10

# IP de LAN do host (SVRUBS24IPS0101) — onde LiveKit/coturn publicam as
# portas raw (não-HTTP, não passam pelo NPM). NÃO é 0.0.0.0.
HOST_LAN_IP=10.20.4.10

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# wss://<subdomínio da sinalização do LiveKit, roteado via NPM>
LIVEKIT_PUBLIC_URL=wss://livekit-test.ffcom.a3sitsolutions.com.br

# IP público usado pelo LiveKit/coturn para anunciar candidatos ICE. NÃO é
# um IP do site IPS01 — os dois links de WAN de lá são inadequados (WAN1/Nio
# é CGNAT, sem nenhuma entrada possível; WAN2/Tim tem IP dinâmico) e o
# roteador do site não expõe nada à internet por política. Toda a exposição
# pública do FFCom passa por VMSUBS24OCI0102 (IP público fixo), que
# encaminha até este host por um túnel próprio da infra — ver
# docs/architecture.md, "Correção: exposição pública via VMSUBS24OCI0102".
TURN_EXTERNAL_IP=137.131.249.145
TURN_STATIC_AUTH_SECRET=
TURN_REALM=ffcom.local

# Faixas de porta — checado em 2026-09-20 via `ss -tuln` em SVRUBS24IPS0101:
# 3478/3479/5349/5350 já ocupados em 10.20.4.10 pelo coturn do stack
# VoIP/FreeSWITCH existente (network_mode=host) — por isso TURN_LISTEN_PORT
# (porta do HOST; o container continua escutando 3478 internamente, via
# --listening-port fixo no compose) usa 33478 em vez do default. As faixas
# de relay do coturn e de RTC do LiveKit não colidiram com nada e mantêm o
# default da referência de self-host em server-channel/docker-compose.yml.
TURN_LISTEN_PORT=33478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50100
