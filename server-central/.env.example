# Copie para .env e preencha antes de rodar `docker compose up`.

# Postgres
POSTGRES_USER=ffcom
POSTGRES_PASSWORD=
POSTGRES_DB=ffcom_central

# Autenticação: server-central é Resource Server puro contra a instância
# central de Authentik do abs-3d-printer (authentik.abs.a3sitsolutions.com.br),
# não uma instância própria. Ver docs/architecture.md e
# D:\Dev\a3s-network\docs\procedures\integrar-app-com-authentik.md para o
# procedimento de registrar o app "ffcom" nela antes de preencher isto.
# Um ou mais issuers separados por vírgula. O mesmo provider do Authentik
# responde por dois domínios e o "iss" do token é o domínio do login: o app
# entra por auth.ffcom (brand do FFCom); authentik.abs fica para tokens de
# antes da troca e para quem ainda não atualizou o client.
OIDC_ISSUER_URL=https://auth.ffcom.a3sitsolutions.com.br/application/o/ffcom/,https://authentik.abs.a3sitsolutions.com.br/application/o/ffcom/

SERVER_CENTRAL_PORT=8081
# Origens do client web/PWA autorizadas a chamar esta instância de uma
# origem diferente (CORS). Lista separada por vírgula. O app desktop
# (app://ffcom) é sempre liberado, sem precisar estar aqui. Em dev local, o
# client roda em http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting por usuário, ou por IP em requisição sem token válido
# (proteção contra abuso, ver docs/architecture.md, "Decisão: rate limiting
# em server-central"; orçamento de cada rota em docs/rate-limits.md).
# Opcionais; os padrões abaixo já se aplicam se omitidas.
# RATE_LIMIT_RPM=120
# RATE_LIMIT_BURST=60

# Exige X-Forwarded-Proto: https em toda requisição (exceto /healthz) — ver
# README.md, "TLS / HTTPS". Só ligue depois de colocar um proxy reverso na
# frente que termine TLS e sete esse header; em dev local sem proxy, deixe
# desligado (padrão).
# REQUIRE_TLS=true

# Upload de avatar de conta (ver docs/architecture.md, "Decisão: upload de
# avatar de conta"). Tamanho máximo do arquivo em MB; opcional, padrão 2.
# AVATAR_MAX_MB=2

# Sugestões de melhoria da home page, com a "varinha" que melhora o texto e
# a checagem final de conteúdo ofensivo feitas pelo Claude via
# a3s-claude-relay (ver docs/architecture.md, "Decisão: sugestões de
# melhoria com varinha do Claude"). Tudo opcional: sem CLAUDE_RELAY_URL a
# varinha fica desligada e toda sugestão enviada vai para moderação.
# CLAUDE_RELAY_URL=http://a3s-claude-relay:3000
# CLAUDE_RELAY_API_KEY=
# Segredo só deste app, conferido no callback (openssl rand -hex 32).
# CLAUDE_CALLBACK_SECRET=
# Como o relay alcança o listener de callback deste container: nome do
# container na rede Docker e a porta interna do callback (CLAUDE_CALLBACK_PORT,
# padrão 8090), nunca uma porta publicada no host.
# CLAUDE_CALLBACK_BASE_URL=http://ffcom-central-app:8090
# Grupo do Authentik que modera as sugestões (padrão ffcom-admins), usos da
# varinha por dia (padrão 3) e quantos usos a mais uma ideia ofensiva custa
# (padrão 2).
# IDEAS_ADMIN_GROUP=ffcom-admins
# IDEAS_WAND_PER_DAY=3
# IDEAS_OFFENSIVE_PENALTY=2

# Pedidos de cadastro pela home page, aprovados por botões no Telegram (ver
# docs/architecture.md, "Decisão: cadastro com aprovação pelo Telegram").
# Tudo opcional: sem TELEGRAM_BOT_TOKEN o formulário responde "cadastro
# indisponível". Com ele, as demais variáveis sem padrão são obrigatórias.
# O bot só envia e edita mensagens; nunca chame setWebhook/getUpdates com
# ele, porque o webhook pertence a quem recebe os cliques (na instância
# oficial, o a3s-network-monitor, que repassa as decisões ao listener
# interno, porta CLAUDE_CALLBACK_PORT, padrão 8090).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Tópico do grupo (o número depois do id do grupo no link de uma mensagem
# do tópico); vazio cai no tópico "Geral".
# TELEGRAM_THREAD_ID=
# Instância do Authentik e token de uma conta de serviço que possa ver e
# criar usuários, adicionar ao grupo e mandar e-mail de recuperação.
# AUTHENTIK_URL=https://authentik.abs.a3sitsolutions.com.br
# AUTHENTIK_API_TOKEN=
# uuid do stage de e-mail do fluxo de recuperação (o link de definir senha).
# AUTHENTIK_RECOVERY_EMAIL_STAGE=
# Segredo conferido no header X-FFCom-Secret das decisões (openssl rand -hex 32).
# SIGNUP_DECISION_SECRET=
# Grupo que dá acesso (padrão ffcom-users), validade do link de senha
# (padrão days=3) e limites do formulário público (padrão 3 por IP por dia
# e 20 por hora no total).
# SIGNUP_USERS_GROUP=ffcom-users
# SIGNUP_RECOVERY_TOKEN_DURATION=days=3
# SIGNUP_MAX_PER_IP_PER_DAY=3
# SIGNUP_MAX_PER_HOUR=20
