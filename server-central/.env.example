# Copie para .env e preencha antes de rodar `docker compose up`.

# Postgres
POSTGRES_USER=ffcom
POSTGRES_PASSWORD=
POSTGRES_DB=ffcom_central

# Autenticação: server-central é Resource Server puro contra a instância
# central de Authentik do abs-3d-printer (authentik.abs.a3sitsolutions.com.br),
# não uma instância própria. Ver docs/architecture.md e
# D:\Dev\a3s-network\docs\procedures\integrar-app-com-authentik.md para o
# procedimento de registrar o app "ffcom" nela antes de preencher isto.
OIDC_ISSUER_URL=https://authentik.abs.a3sitsolutions.com.br/application/o/ffcom/

SERVER_CENTRAL_PORT=8081
