# Copie para .env e preencha antes de rodar `docker compose up`.
# Gerar segredos: openssl rand -hex 32

# Postgres
POSTGRES_USER=ffcom
POSTGRES_PASSWORD=
POSTGRES_DB=ffcom_channel

# LiveKit (SFU de voz/vídeo) — par chave/segredo usado só pelo app de
# server-channel para assinar os access tokens que emite para o client
# (nunca exposto ao client). Qualquer string forte serve.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Endereço público (ws:// ou wss://) pelo qual o client alcança o LiveKit
# diretamente — precisa estar acessível de fora da rede do host (porta 7880
# encaminhada/exposta), já que a conexão de voz não passa pelo server-channel.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Faixa de portas UDP para mídia RTC. Precisa estar liberada/encaminhada no
# roteador se o server-channel estiver hospedado atrás de NAT.
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50100

# coturn (TURN/STUN para NAT traversal)
# IP público do host (ou o IP para o qual o roteador encaminha as portas).
# Obrigatório para quem estiver atrás de NAT residencial.
TURN_EXTERNAL_IP=
TURN_REALM=ffcom.local
TURN_STATIC_AUTH_SECRET=
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# Autenticação: mesma instância central de Authentik do abs-3d-printer usada
# por server-central (não uma instância própria) — ver docs/architecture.md,
# "modelo de dados de server-channel".
OIDC_ISSUER_URL=https://authentik.abs.a3sitsolutions.com.br/application/o/ffcom/

# App server-channel
SERVER_CHANNEL_PORT=8080
# Origens (client web/PWA, build Electron empacotado) autorizadas a chamar
# esta instância de uma origem diferente (CORS + WebSocket). Lista separada
# por vírgula; vazio = nenhuma origem cruzada liberada. Em dev local, o
# client roda em http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
